rules_version = '2';

// Broast Al Bahr — Firestore rules (shared with customer app).
// The customer app has no Firebase Auth (admin is app-password gated),
// so the customer needs to read back their own orders on next open.
// Both apps run against the same Firebase project — keep this file in sync
// with broast-albahr/firestore.rules.
service cloud.firestore {
  match /databases/{database}/documents {

    match /settings/{doc} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /customers/{phone} {
      allow read, write: if true;
    }

    // Per-branch atomic order-number counters (orderNo-{branchId}).
    // MUST be readable/writable or nextOrderNo falls back to random numbers.
    match /counters/{counterId} {
      allow read, write: if true;
    }

    match /notifications/{phone}/items/{itemId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
